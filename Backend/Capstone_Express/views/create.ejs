<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Create Post</title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="/form.css">
</head>
<body>
  <h1>Create a New Blog Post</h1>

  <form class="form-group" action="/submit-post" method="POST">
    <div class="form-group-inline">
      <label class="form-label" for="title">Title:</label><br>
      <input type="text" id="post-title" name="title" class="form-control" placeholder="Enter post title" required>
    </div>
    <br>
    <div class="form-group-inline">
      <label class="form-label" for="content">Content:</label><br>
      <textarea id="content" class="form-control" placeholder="Enter post content" name="content" rows="6" cols="40" required></textarea>
    </div>
    <br>
    <div class="form-buttons">
        <button class="btn btn-submit" type="submit">Submit Post</button>
        <a href="/" class="btn btn-cancel">Cancel</a>
    </div>
    
  </form>

  <!-- <a href="/"><button>Back to Home</button></a> -->
</body>
</html>