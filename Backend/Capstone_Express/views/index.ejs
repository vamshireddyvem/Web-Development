<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  
  <title>Blog Home</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <h1>My Blog</h1>

  <a href="/create">
    <button type="button">Create New Post</button>
  </a>

  <h2>All Posts</h2>
  
  <ol>
    <% posts.forEach(post => { %>
      <li>
        <a href="/post/<%= post.id %>"><%= post.title %></a>
        
        <!-- Edit Link/Button -->
        <a href="/edit/<%= post.id %>">
          <button type="button">Edit</button>
        </a>

        <!-- Delete Button Form -->
        <form action="/delete-post/<%= post.id %>" method="POST" style="display:inline;">
          <button type="submit">Delete</button>
        </form>
      </li>
    <% }); %>
  </ol>
</body>
</html>